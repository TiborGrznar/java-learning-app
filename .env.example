DB_NAME=java_learning_app
DB_USER=jla_app
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
DB_PORT=3306
JWT_SECRET=replace-with-base64-encoded-256-bit-key

# First administrator, created at startup only when no administrator exists yet.
# Set both ADMIN_EMAIL and ADMIN_PASSWORD (password: at least 12 characters).
# Remove ADMIN_PASSWORD from the environment after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SURNAME=

# Shared secret between the backend and the code runner (runner/). At least 32 characters.
# Generate one in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
RUNNER_TOKEN=
