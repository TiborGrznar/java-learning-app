DB_NAME=java_learning_app
DB_USER=jla_app
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
DB_PORT=3306
JWT_SECRET=replace-with-base64-encoded-256-bit-key

# First administrator, created at startup only when no administrator exists yet.
# Set both ADMIN_EMAIL and ADMIN_PASSWORD (password: at least 12 characters).
# Remove ADMIN_PASSWORD from the environment after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SURNAME=

# Shared secret between the backend and the code runner (runner/). At least 32 characters.
# Both the backend and the runner refuse to start without it. Never commit the real value.
# Generate one in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
RUNNER_TOKEN=

# Optional: where the backend finds the code runner (default http://127.0.0.1:8081).
# Keep it commented out unless the runner runs elsewhere: an empty value breaks the startup.
# RUNNER_BASE_URL=http://127.0.0.1:8081

# Optional: browser origins that may call the API (comma separated, exact, no wildcard, no path).
# Keep it commented out when the frontend and /api are served from one address (the Vite dev proxy
# or a reverse proxy): CORS is then off, which is the safe default.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: turns on the OpenAPI description (/v3/api-docs) and Swagger UI (/swagger-ui.html).
# For local development only: while on, both are open to anyone who can reach the backend.
# API_DOCS_ENABLED=true
