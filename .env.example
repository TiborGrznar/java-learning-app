# Set both ADMIN_EMAIL and ADMIN_PASSWORD (password: at least 12 characters).
# Remove ADMIN_PASSWORD from the environment after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SURNAME=
